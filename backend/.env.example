# ─────────────────────────────────────────────────────────
# IntelliCredit Backend — Environment Variables Template
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────
FIREBASE_PROJECT_ID=intelli-credit-ai-dhanu
# Path to your Firebase service account JSON (leave blank to use ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# ── B2B Tenant API Keys (JSON map) ───────────────────────
# Format: {"key": {"tenant_id": "...", "tier": "enterprise", "webhook_url": "..."}}
TENANT_API_KEYS={}

# ── AI / LLM Keys ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── External Data APIs ────────────────────────────────────
SIGNZY_API_KEY=your_signzy_api_key_here
KARZA_API_KEY=your_karza_api_key_here
CIBIL_API_KEY=your_cibil_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ── Database ──────────────────────────────────────────────
# PostgreSQL async connection URL (v2 policy engine)
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/intellicredit
# SQLite fallback for workflow engine
DATABASE_URL=sqlite:///./intellicredit.db

# ── Databricks (Optional) ─────────────────────────────────
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_ACCESS_TOKEN=

# ── Credential Vault ──────────────────────────────────────
# 32-byte Fernet key for encrypting credentials at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_VAULT_KEY=your_fernet_key_here

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30

# ── App Settings ──────────────────────────────────────────
# Set to "true" ONLY in local dev to skip Firebase signature verification
SKIP_FIREBASE_VERIFY=false
ENVIRONMENT=production
